VITE_WHOP_ACCOUNT_ID=
VITE_INSPECTION_PLAN=
VITE_DEPOSIT_PLAN=
VITE_SERVICE_PLAN=
# Server-only Whop credentials are supplied by Whop hosting or a secure environment binding.
# Never use a VITE_ prefix for an API key.
WHOP_COMPANY_ID=
# Bind WHOP_API_KEY as a server-only secret in the hosting environment.
# For local sandbox server tests, use WHOP_ENVIRONMENT=sandbox and bind
# WHOP_SANDBOX_API_KEY server-side. Vite's --mode sandbox only changes public IDs.
